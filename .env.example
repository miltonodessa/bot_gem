# Solana Wallet
PRIVATE_KEY=your_base58_private_key_here
RPC_URL=https://api.mainnet-beta.solana.com
BACKUP_RPC_URL=https://rpc.helius.xyz/?api-key=YOUR_KEY

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_PRICE_API=https://price.jup.ag/v4

# Twitter/X API (for narrative scanning)
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Anthropic API (claude-haiku-4-5-20251001 vision — detects animals in token images)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Helius API (for token data)
HELIUS_API_KEY=your_helius_key_here

# DexScreener (no key needed, but keep for reference)
DEXSCREENER_API=https://api.dexscreener.com/latest/dex

# Birdeye API (optional, for deeper token analytics)
BIRDEYE_API_KEY=your_birdeye_key_here

# Trading Parameters
TRADE_AMOUNT_SOL=0.5           # SOL per trade (~$100-300 at current prices)
MAX_DAILY_TRADES=20            # Max trades per day
MAX_CONCURRENT_POSITIONS=3     # Max open positions at once
STOP_LOSS_PCT=25               # Stop loss % (exit if down this much)
TAKE_PROFIT_PCT=150            # Take profit % (exit at 2.5x)
MAX_HOLD_HOURS=6               # Hard exit after 6 hours (avoid disaster zone)
TARGET_HOLD_MINUTES=90         # Target hold time center (30-120min conviction window)

# Market Cap Filters (Golden Zone)
MIN_MARKET_CAP=5000            # $5k minimum
MAX_MARKET_CAP=20000           # $20k maximum (golden zone)
MAX_EXTENDED_CAP=500000        # Extended zone cap (for narrative conviction plays)

# Slippage
MAX_SLIPPAGE_BPS=300           # 3% max slippage

# Bot behavior
DRY_RUN=true                   # Set to false for live trading
LOG_LEVEL=INFO
NARRATIVE_REFRESH_MINUTES=60   # Re-scan Twitter every 60 min

# Risk limits
MAX_POSITION_SIZE_SOL=1.0      # Never exceed this per position
DAILY_LOSS_LIMIT_SOL=2.0       # Stop trading if daily loss exceeds this
